# Copia este archivo como ".env" (en la misma carpeta que server.js) y completa solo lo que uses.
# El archivo .env se lee en el servidor y nunca se envía al navegador. No lo compartas.

# Puerto local (por defecto 3000)
# PORT=3000

# 1 = no contactar ninguna fuente externa (usa solo capturas guardadas)
# OFFLINE=0

# Mercado Libre Perú — API oficial. Crea una aplicación en https://developers.mercadolibre.com.pe
# y copia aquí su "App ID" y "Secret Key". Con eso el servidor obtiene tokens temporales solo.
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=

# Opcional: sitio anterior de PrecioAlerta. La app ya no lo necesita; solo se usa si defines ORIGIN
# y además pones "origin": { "mode": "on" } en config/sources.json.
# ORIGIN=
